    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-6">
          <h5 class="fw-bold mb-1">🌆 শহরের সন্ধ্যা'zzz v0.4</h5>
          <small class="text-muted">Its All about spreading positivity</small>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
          <a href="#" class="text-decoration-none text-muted me-3">About</a>
          <a href="#" class="text-decoration-none text-muted me-3">Businesses</a>
          <a href="#" class="text-decoration-none text-muted">Contact</a>
        </div>
      </div>
      <hr />
      <div class="text-center text-muted small">
        © <%= new Date().getFullYear() %> শহরের সন্ধ্যা'zzz - Designed, Devoloped and Manages By - Arindamm Samadder 
      </div>
    </div>
  </footer> -->
    <%- include("./partials/chatbot") %>
    <%- include('./partials/scripts') %>
  </body>
</html>

<script>
  // Center the map somewhere sensible as a default (e.g. your city, or user's browser geolocation)
  const pickerMap = L.map('location-picker-map').setView([22.5726, 88.3639], 12); // Kolkata as example default

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '@Arindam-S',
  }).addTo(pickerMap);

  let marker; // keep a reference so we can move it instead of stacking new ones

  pickerMap.on('click', function (e) {
    const { lat, lng } = e.latlng;

    // Fill the hidden inputs so they get submitted with the form
    document.getElementById('lat-input').value = lat;
    document.getElementById('lng-input').value = lng;

    // Move existing marker, or create one if this is the first click
    if (marker) {
      marker.setLatLng(e.latlng);
    } else {
      marker = L.marker(e.latlng).addTo(pickerMap);
    }

    document.getElementById('location-hint').textContent =
      `Location set: ${lat.toFixed(4)}, ${lng.toFixed(4)}`;
  });

  const createPostBox = document.getElementById('postBox'); // match your real toggle wrapper's ID
  createPostBox.addEventListener('shown.bs.collapse', function () {
    pickerMap.invalidateSize();
  });
</script>