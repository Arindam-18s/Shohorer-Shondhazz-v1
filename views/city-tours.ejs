<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Leaflet CSS -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.68)),
          url("./images/backround-image.jpeg");
        background-size: cover;
        background-position: center 20%;
        background-attachment: fixed;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }
    </style>
  
    <%- include('./partials/head') %>
    <title>SEQ'S Surroundings</title>
  </head>
  <body>
    <%- include('./partials/nav') %>
        <section class="container py-5">
            <!-- PAGE HEADER -->
            <div class="text-center mb-5">
                <h1 class="display-7 fw-bold mt-2">
                Your শহর, Your শহুরে Way ✨
                </h1>

                <p class="text-muted fs-5">
                Pick a plan and discover the places worth wandering through.
                </p>
                <span class="badge rounded-pill text-bg-primary px-3 py-2">
                🗺️ EXPLORE THE CITY
                </span>
                
            </div>
            
            <!-- TOUR PLANS -->
            <div class="row g-4">

                <!-- PLAN 1 -->
                <div class="col-lg-6">
                <div class="card h-100 shadow-lg border-0 overflow-hidden">

                    <div id="tourCarousel1"
                        class="carousel slide"
                        data-bs-ride="carousel">

                    <div class="carousel-inner">

                        <div class="carousel-item active">
                        <img src="/images/tours/north-kolkata.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                        <div class="carousel-item">
                        <img src="/images/tours/kumartuli.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                        <div class="carousel-item">
                        <img src="/images/tours/college-street.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                    </div>

                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#tourCarousel1"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#tourCarousel1"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>

                    </div>

                    <div class="card-body p-4">

                    <span class="badge text-bg-danger mb-2">
                        🔥 CULTURE
                    </span>

                    <h3 class="card-title">
                        North Kolkata Evening
                    </h3>

                    <p class="text-muted">
                        Heritage buildings, Kumartuli, College Street,
                        old cafés and the soul of North Kolkata.
                    </p>

                    <div class="d-flex gap-3 mb-3">
                        <span>⏱️ 5 hrs</span>
                        <span>🚶 Walking</span>
                        <span>🍛 Food</span>
                    </div>

                    <a href="/tour/north-kolkata"
                        class="btn btn-dark rounded-pill px-4">
                        Explore Plan →
                    </a>

                    </div>
                </div>
                </div>


                <!-- PLAN 2 -->
                <div class="col-lg-6">
                <div class="card h-100 shadow-lg border-0 overflow-hidden">

                    <div id="tourCarousel2"
                        class="carousel slide"
                        data-bs-ride="carousel">

                    <div class="carousel-inner">

                        <div class="carousel-item active">
                        <img src="/images/tours/park-street.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                        <div class="carousel-item">
                        <img src="/images/tours/victoria.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                        <div class="carousel-item">
                        <img src="/images/tours/maidan.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                    </div>

                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#tourCarousel2"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#tourCarousel2"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>

                    </div>

                    <div class="card-body p-4">

                    <span class="badge text-bg-warning mb-2">
                        🌆 CITY LIGHTS
                    </span>

                    <h3 class="card-title">
                        Central Kolkata
                    </h3>

                    <p class="text-muted">
                        Victoria Memorial, Maidan, Park Street
                        and Kolkata's evening lights.
                    </p>

                    <div class="d-flex gap-3 mb-3">
                        <span>⏱️ 4 hrs</span>
                        <span>🚕 Easy Ride</span>
                        <span>📸 Photography</span>
                    </div>

                    <a href="/tour/central-kolkata"
                        class="btn btn-dark rounded-pill px-4">
                        Explore Plan →
                    </a>

                    </div>
                </div>
                </div>


                <!-- PLAN 3 -->
                <div class="col-lg-6">
                <div class="card h-100 shadow-lg border-0 overflow-hidden">

                    <div id="tourCarousel3"
                        class="carousel slide"
                        data-bs-ride="carousel">

                    <div class="carousel-inner">

                        <div class="carousel-item active">
                        <img src="/images/tours/south-kolkata.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                        <div class="carousel-item">
                        <img src="/images/tours/kalighat.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                        <div class="carousel-item">
                        <img src="/images/tours/gariahat.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                    </div>

                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#tourCarousel3"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#tourCarousel3"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>

                    </div>

                    <div class="card-body p-4">

                    <span class="badge text-bg-success mb-2">
                        🌿 RELAXED
                    </span>

                    <h3 class="card-title">
                        South Kolkata Chill
                    </h3>

                    <p class="text-muted">
                        Cafés, markets, temples, art and relaxed
                        neighbourhood exploration.
                    </p>

                    <div class="d-flex gap-3 mb-3">
                        <span>⏱️ 4 hrs</span>
                        <span>☕ Cafés</span>
                        <span>🛍️ Shopping</span>
                    </div>

                    <a href="/tour/south-kolkata"
                        class="btn btn-dark rounded-pill px-4">
                        Explore Plan →
                    </a>

                    </div>
                </div>
                </div>


                <!-- PLAN 4 -->
                <div class="col-lg-6">
                <div class="card h-100 shadow-lg border-0 overflow-hidden">

                    <div id="tourCarousel4"
                        class="carousel slide"
                        data-bs-ride="carousel">

                    <div class="carousel-inner">

                        <div class="carousel-item active">
                        <img src="/images/tours/food-tour.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                        <div class="carousel-item">
                        <img src="/images/tours/street-food.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                        <div class="carousel-item">
                        <img src="/images/tours/sweets.jpg"
                            class="d-block w-100"
                            style="height:280px; object-fit:cover;">
                        </div>

                    </div>

                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#tourCarousel4"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#tourCarousel4"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>

                    </div>

                    <div class="card-body p-4">

                    <span class="badge text-bg-danger mb-2">
                        🍛 FOODIE
                    </span>

                    <h3 class="card-title">
                        Kolkata Food Crawl
                    </h3>

                    <p class="text-muted">
                        Street food, Bengali sweets, iconic cafés
                        and legendary local dishes.
                    </p>

                    <div class="d-flex gap-3 mb-3">
                        <span>⏱️ 3 hrs</span>
                        <span>🍜 Food</span>
                        <span>❤️ Local</span>
                    </div>

                    <a href="/tour/food-crawl"
                        class="btn btn-dark rounded-pill px-4">
                        Explore Plan →
                    </a>

                    </div>
                </div>
                </div>

            </div>
            </section>


            <!-- MAP SECTION -->

            <section class="container pb-5">

            <div class="text-center mb-4">
                <span class="text-primary fw-semibold">
                📍 PLAN YOUR ROUTE
                </span>

                <h2 class="fw-bold">
                Explore All Four Plans
                </h2>

                <p class="text-muted">
                See where each experience takes you.
                </p>
            </div>

            <div class="card border-0 shadow-lg overflow-hidden">
                <div id="tour-map"
                    style="height:500px; width:100%;">
                </div>
            </div>

        </section>

    <%- include("./partials/chatbot") %>
    <%- include('./partials/scripts') %>
  </body>
</html>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<!-- Leaflet JavaScript -->
<script>
  const tourMap = L.map("tour-map").setView(
    [22.5726, 88.3639],
    12
  );
  L.tileLayer(
    "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
      attribution: "&copy; OpenStreetMap contributors"
    }
  ).addTo(tourMap);
  // NORTH KOLKATA
  const northKolkata = [
    [22.636, 88.412],
    [22.594, 88.369],
    [22.585, 88.363],
    [22.576, 88.365]
  ];
 // CENTRAL KOLKATA
  const centralKolkata = [
    [22.544, 88.342],
    [22.548, 88.343],
    [22.555, 88.350],
    [22.552, 88.361]
  ];
  // SOUTH KOLKATA
  const southKolkata = [
    [22.520, 88.342],
    [22.520, 88.356],
    [22.516, 88.366],
    [22.509, 88.369]
  ];
  // FOOD TOUR
  const foodTour = [
    [22.595, 88.363],
    [22.584, 88.365],
    [22.572, 88.363],
    [22.558, 88.350]
  ];
  // Draw routes
  L.polyline(northKolkata, {
    weight: 5
  }).addTo(tourMap)
    .bindPopup("🔥 North Kolkata Evening");

  L.polyline(centralKolkata, {
    weight: 5
  }).addTo(tourMap)
    .bindPopup("🌆 Central Kolkata");

  L.polyline(southKolkata, {
    weight: 5
  }).addTo(tourMap)
    .bindPopup("🌿 South Kolkata");

  L.polyline(foodTour, {
    weight: 5
  }).addTo(tourMap)
    .bindPopup("🍛 Kolkata Food Crawl");

  // Mark important locations
  L.marker([22.636, 88.412])
    .addTo(tourMap)
    .bindPopup("📍 Starting Point");

  L.marker([22.594, 88.369])
    .addTo(tourMap)
    .bindPopup("🏺 Kumartuli");

  L.marker([22.572, 88.363])
    .addTo(tourMap)
    .bindPopup("📚 College Street");

  L.marker([22.544, 88.342])
    .addTo(tourMap)
    .bindPopup("🏛️ Victoria Memorial");

  L.marker([22.520, 88.342])
    .addTo(tourMap)
    .bindPopup("🌿 South Kolkata");

  setTimeout(() => {
    tourMap.invalidateSize();
  }, 300);

</script>
