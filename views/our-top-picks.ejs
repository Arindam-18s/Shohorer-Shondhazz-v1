    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script>
      let dbMap, aiMap;
      let allRoutes = [];
      let mapsReady = false;
      let currentMode = 'db';

      function ensureMapsExist() {
        if (mapsReady) return;
        dbMap = L.map("map").setView([22.57, 88.36], 12);
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
          attribution: "powered by - Arindam@S"
        }).addTo(dbMap);
        aiMap = L.map("aiMap").setView([22.57, 88.36], 12);
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
          attribution: "powered by - Arindam@S"
        }).addTo(aiMap);
        mapsReady = true;
      }

      function clearMap(mapInstance) {
        mapInstance.eachLayer(layer => {
          if (layer instanceof L.Marker || layer instanceof L.Polyline || layer instanceof L.CircleMarker) {
            mapInstance.removeLayer(layer);
          }
        });
      }

      function drawRoute(mapInstance, route, titleId) {
        if (!route.stops || route.stops.length < 2) {
          console.error("Invalid route: needs at least 2 stops");
          return;
        }
        clearMap(mapInstance);
        document.getElementById(titleId).textContent = route.title || "Route";

        const coords = route.stops.map(s => `${s.longitude},${s.latitude}`).join(';');
        const url = `https://router.project-osrm.org/route/v1/driving/${coords}?overview=full&geometries=geojson`;

        fetch(url)
          .then(r => r.json())
          .then(data => {
            if (data.routes?.[0]) {
              const latlngs = data.routes[0].geometry.coordinates.map(c => L.latLng(c[1], c[0]));
              L.polyline(latlngs, { color: '#0066ff', weight: 4, opacity: 0.8 }).addTo(mapInstance);
            }

            route.stops.forEach((stop, i) => {
              L.circleMarker([stop.latitude, stop.longitude], {
                radius: 12,
                fillColor: "#FF6B6B",
                color: "#fff",
                weight: 2,
                fillOpacity: 0.9
              })
              .bindPopup(`<strong>${i + 1}. ${stop.name}</strong><br>${stop.time || ''}`, {
                autoClose: false,
                closeOnClick: false
              })
              .addTo(mapInstance)
              .openPopup();
            });

            const group = new L.featureGroup(route.stops.map(s => L.marker([s.latitude, s.longitude])));
            mapInstance.fitBounds(group.getBounds().pad(0.1));
          })
          .catch(err => console.error("Route drawing error:", err));
      }

      async function loadDbRoutes() {
        try {
          const res = await fetch("/our-top-picks/itineraries");
          allRoutes = await res.json();
          if (allRoutes.length > 0 && currentMode === 'db') {
            refreshDbMap();
          }
        } catch (error) {
          console.error("Failed to load routes:", error);
        }
      }

      function refreshDbMap() {
        if (!mapsReady || currentMode !== 'db') return;
        clearMap(dbMap);
        document.getElementById("route-list").innerHTML = "";

        const newest = [...allRoutes]
          .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))
          .slice(0, 3);

        newest.forEach((route, idx) => {
          const btn = document.createElement("button");
          btn.className = "btn btn-sm btn-outline-primary me-2";
          btn.textContent = `Route ${idx + 1}`;
          btn.onclick = () => drawRoute(dbMap, route, "mapTitle");
          document.getElementById("route-list").appendChild(btn);
        });

        if (newest.length > 0) {
          drawRoute(dbMap, newest[0], "mapTitle");
        }
      }

      window.showAiRoute = function(route) {
        if (!route || !route.stops || route.stops.length < 2) {
          console.error("Invalid route data for AI map");
          return;
        }

        const panel = document.getElementById("mapPanel");
        if (!panel) return;

        const doDraw = () => {
          ensureMapsExist();
          currentMode = 'ai';
          document.getElementById("dbMapContainer").style.display = "none";
          document.getElementById("route-list").style.display = "none";
          document.getElementById("aiMapContainer").style.display = "block";
          document.getElementById("mapTitle").textContent = "🤖 AI Generated Route";
          setTimeout(() => {
            aiMap.invalidateSize();
            drawRoute(aiMap, route, "aiMapTitle");
          }, 100);
        };

        const alreadyOpen = panel.classList.contains("show");
        if (!alreadyOpen) {
          panel.addEventListener("shown.bs.collapse", doDraw, { once: true });
          new bootstrap.Collapse(panel, { show: true });
        } else {
          doDraw();
        }
      };

      window.resetToDbView = function() {
        currentMode = 'db';
        document.getElementById("dbMapContainer").style.display = "block";
        document.getElementById("route-list").style.display = "block";
        document.getElementById("aiMapContainer").style.display = "none";
        document.getElementById("mapTitle").textContent = "Map Routes";
        if (mapsReady) {
          dbMap.invalidateSize();
          refreshDbMap();
        }
      };

      document.getElementById("mapPanel").addEventListener("shown.bs.collapse", () => {
        ensureMapsExist();
        if (currentMode === 'db') {
          dbMap.invalidateSize();
          if (allRoutes.length === 0) {
            loadDbRoutes();
          } else {
            refreshDbMap();
          }
        } else {
          aiMap.invalidateSize();
        }
      });

      loadDbRoutes();
    </script>

