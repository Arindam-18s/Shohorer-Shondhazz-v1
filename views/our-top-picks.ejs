      .card {
        background: transparent !important;
        border: none;
        overflow: hidden;
      }
      .card-body {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(20px) saturate(150%);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.782);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
      }
      .toast-message {
        display: none;
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: #c08d7f;
        color: #594d71;
        padding: 12px 24px;
        border-radius: 8px;
        z-index: 99999;
        border: 3px solid rgb(189, 221, 9);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
      }
      .map-box {
        height: 400px;
        width: 100%;
        position: relative;
      }
      #map, #aiMap {
        height: 100%;
        width: 100%;
        position: absolute;
        top: 0;
        left: 0;
      }
      footer {
