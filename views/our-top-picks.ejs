<script>
function showToast(button) {
  const card = button.closest(".card-body"); // finds nearest ancestor with this class, however deep
  const toast = card ? card.querySelector(".toast-message") : null;
  if (!toast) {
    console.error("No toast element found for this card");
    return;
  }
  toast.style.display = "block";
  setTimeout(() => toast.style.display = "none", 3000);
}
</script>

<script>
function showToast() {
    const toast = document.getElementById("saveToast");

    toast.style.display = "block";

    setTimeout(() => {
        toast.style.display = "none";
    }, 2500);
}
</script>