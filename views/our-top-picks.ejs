        padding: 35px 0;
        background: linear-gradient(rgba(74, 79, 139, 0.62), rgba(248, 186, 186, 0.68));
        backdrop-filter: blur(10px);
        border-top: 1px solid rgba(0, 0, 0, 0.05);
      }
