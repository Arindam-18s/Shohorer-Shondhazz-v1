      <script>
              var eventMap = L.map("event-picker-map").setView([22.57, 88.36], 12);

              L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: "powered by - Arindam@S",
              }).addTo(eventMap);

              document.getElementById("postBox").addEventListener("shown.bs.collapse", function () {
                eventMap.invalidateSize();

                // Only add markers once the map has correct real dimensions
                L.marker([22.6000, 88.3614])
                  .addTo(eventMap)
                  .bindPopup("Kumortuli", { autoClose: false})
                  .openPopup();

                L.marker([22.6500, 88.3814])
                  .addTo(eventMap)
                  .bindPopup("Bagbazar", { autoClose: false}) // <-- also fixing the duplicate label, see note below
                  .openPopup();
              }, { once: true }); // ensures markers only get added once, not re-added every time the box reopens
      </script>

