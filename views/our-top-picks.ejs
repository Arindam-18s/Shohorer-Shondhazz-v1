<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.30), rgba(255, 255, 255, 0.38)),
          url("./images/backround-image.jpeg");
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }
      .card {
        background: transparent !important;
        border: none;
        overflow: hidden;
      }
      .card-body {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(20px) saturate(150%);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.782);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
      }
      .toast-message {
        display: none;
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: #c08d7f;
        color: #594d71;
        padding: 12px 24px;
        border-radius: 8px;
        z-index: 99999;
        border: 3px solid rgb(189, 221, 9);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
      }
      footer {
        margin-top: 80px;
        padding: 35px 0;
        background: linear-gradient(rgba(74, 79, 139, 0.62), rgba(248, 186, 186, 0.68));
        backdrop-filter: blur(10px);
        border-top: 1px solid rgba(0, 0, 0, 0.05);
      }
    </style>
    <%- include('./partials/head') %>
    <title>শহরের সন্ধ্যা'zzz</title>
  </head>
  <body>
    <%- include('./partials/nav') %>
    <div class="container-fluid mt-2" style="background-color: rgb(245, 244, 242, .45);"><h3 align="center">শহরে'র আমাদের Best Pickss 🤓😗</h3></div>

    <div class="container-fluid mt-2">
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-3 g-4">

        <div class="col">
          <div class="card h-100">
            <div id="carousel-mitra-cafe" class="carousel slide" data-bs-ride="carousel">
              <div class="carousel-inner">
                <div class="carousel-item active">
                  <img src="/images/ourTopPicks/kumortuli_1.jpg" class="d-block w-100 card-img-top" alt="Kumortuli Walkarounds">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/kumortuli_2.avif" class="d-block w-100 card-img-top" alt="Kumortuli Walkarounds">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/kumortuli_1.jpg" class="d-block w-100 card-img-top" alt="Kumortuli Walkarounds">
                </div>
              </div>
              <button class="carousel-control-prev" type="button" data-bs-target="#carousel-mitra-cafe" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carousel-mitra-cafe" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>
            <div class="card-body">
              <h5 class="card-title">Kumortuli Walkarounds (Sovabazar)</h5>
              <p class="card-text">A famous traditional potters' quarter in North Kolkata, where local artisans sculpt clay idols of Hindu gods and goddesses, most notably for the annual Durga Puja festival.</p>
              <a class="btn btn-primary" onclick="showToast()">Save For an Evening</a>
            </div>
          </div>
        </div>

        <div class="col">
          <div class="card h-100">
            <div id="carousel-2" class="carousel slide" data-bs-ride="carousel">
              <div class="carousel-inner">
                <div class="carousel-item active">
                  <img src="/images/ourTopPicks/dulhouse_2.jpg" class="d-block w-100 card-img-top" alt="Dalhousie Square">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/dulhouse_1.jpg" class="d-block w-100 card-img-top" alt="Dalhousie Square">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/dulhouse_2.jpg" class="d-block w-100 card-img-top" alt="Dalhousie Square">
                </div>
              </div>
              <button class="carousel-control-prev" type="button" data-bs-target="#carousel-2" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carousel-2" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>
            <div class="card-body">
              <h5 class="card-title">Dalhousie - The Heart of the City</h5>
              <p class="card-text">The former Dalhousie Square, now known as Benoy-Badal-Dinesh Bagh, is an oasis at the heart of modern Kolkata, formerly Calcutta.</p>
              <a class="btn btn-primary" onclick="showToast()">Save For an Evening</a>
            </div>
          </div>
        </div>

        <div class="col">
          <div class="card h-100">
            <div id="carousel-3" class="carousel slide" data-bs-ride="carousel">
              <div class="carousel-inner">
                <div class="carousel-item active">
                  <img src="/images/ourTopPicks/bagbazar_1.jpg" class="d-block w-100 card-img-top" alt="Bagbazar Ghat">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/bagbazar_2.jpg" class="d-block w-100 card-img-top" alt="Bagbazar Ghat">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/bagbazar_3.png" class="d-block w-100 card-img-top" alt="Bagbazar Ghat">
                </div>
              </div>
              <button class="carousel-control-prev" type="button" data-bs-target="#carousel-3" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carousel-3" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>
            <div class="card-body">
              <h5 class="card-title">Exploring Bagbazar and Its Famous Ghats</h5>
              <p class="card-text">Bagbazar is a historic neighbourhood in North Kolkata, by the Hooghly River to the west, featuring key local spots like Bagbazar Ghat, Mayer Bari, and more.</p>
              <a class="btn btn-primary" onclick="showToast()">Save For an Evening</a>
            </div>
          </div>
        </div>

        <div class="col">
          <div class="card h-100">
            <div id="carousel-4" class="carousel slide" data-bs-ride="carousel">
              <div class="carousel-inner">
                <div class="carousel-item active">
                  <img src="/images/ourTopPicks/cemetry_1.jpg" class="d-block w-100 card-img-top" alt="South Park Street Cemetery">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/cemetry_2.webp" class="d-block w-100 card-img-top" alt="South Park Street Cemetery">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/cemetry_3.jpg" class="d-block w-100 card-img-top" alt="South Park Street Cemetery">
                </div>
              </div>
              <button class="carousel-control-prev" type="button" data-bs-target="#carousel-4" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carousel-4" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>
            <div class="card-body">
              <h5 class="card-title">Spooky Afternoon at Park Street Cemetery</h5>
              <p class="card-text">South Park Street Cemetery, also known as the 'Great Christian Burial Ground', was one of the earliest non-church cemeteries in the world. It houses numerous graves and monuments belonging to British soldiers, administrators, and their families.</p>
              <a class="btn btn-primary" onclick="showToast()">Save For an Evening</a>
            </div>
          </div>
        </div>

        <div class="col">
          <div class="card h-100">
            <div id="carousel-5" class="carousel slide" data-bs-ride="carousel">
              <div class="carousel-inner">
                <div class="carousel-item active">
                  <img src="/images/ourTopPicks/princep_1.jpg" class="d-block w-100 card-img-top" alt="Prinsep Ghat">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/pincep_2.png" class="d-block w-100 card-img-top" alt="Prinsep Ghat">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/princep_1.jpg" class="d-block w-100 card-img-top" alt="Prinsep Ghat">
                </div>
              </div>
              <button class="carousel-control-prev" type="button" data-bs-target="#carousel-5" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carousel-5" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>
            <div class="card-body">
              <h5 class="card-title">Lovely Evenings at Prinsep Ghat</h5>
              <p class="card-text">Prinsep Ghat is a beautiful riverside promenade in Kolkata. It is a popular spot for picnics, boat rides, and relaxing walks along the Hooghly River.</p>
              <a class="btn btn-primary" onclick="showToast()">Save For an Evening</a>
            </div>
          </div>
        </div>

        <div class="col">
          <div class="card h-100">
            <div id="carousel-6" class="carousel slide" data-bs-ride="carousel">
              <div class="carousel-inner">
                <div class="carousel-item active">
                  <img src="/images/ourTopPicks/eden_1.jpg" class="d-block w-100 card-img-top" alt="Eden Gardens">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/eden_2.jpg" class="d-block w-100 card-img-top" alt="Eden Gardens">
                </div>
                <div class="carousel-item">
                  <img src="/images/ourTopPicks/eden_1.jpg" class="d-block w-100 card-img-top" alt="Eden Gardens">
                </div>
              </div>
              <button class="carousel-control-prev" type="button" data-bs-target="#carousel-6" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carousel-6" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>
            <div class="card-body">
              <h5 class="card-title">Calm Afternoons at Eden Gardens Park</h5>
              <p class="card-text">Although most people identify the name 'Eden Gardens' with the iconic cricket stadium in Calcutta, the garden, then called Auckland Circus Garden, was opened to the public in 1840, its construction supervised by Emily and Fanny Auckland.</p>
              <a class="btn btn-primary" onclick="showToast()">Save For an Evening</a>
            </div>
          </div>
        </div>

        <div class="col">
          <div class="card h-100">
            <img src="/images/ourTopPicks/gazeebo.webp" class="card-img-top" alt="The Gazeboo">
            <div class="card-body">
              <h5 class="card-title">The Gazeboo (Park Lane/Esplanade)</h5>
              <p class="card-text">Vibe: Extremely high footfall, trendy aesthetic setup known for viral massive thalis and late-night crowd.</p>
              <a class="btn btn-primary" onclick="showToast()">Save For an Evening</a>
            </div>
          </div>
        </div>

        <div class="col">
          <div class="card h-100">
            <img src="/images/ourTopPicks/mitra_cafe.webp" class="card-img-top" alt="Mitra Cafe">
            <div class="card-body">
              <h5 class="card-title">Mitra Cafe (Sovabazar)</h5>
              <p class="card-text">Packed every evening with snack lovers craving legendary Kabiraji cutlets and fish fry.</p>
              <a class="btn btn-primary" onclick="showToast()">Save For an Evening</a>
            </div>
          </div>
        </div>

        <div class="col">
          <div class="card h-100">
            <img src="/images/ourTopPicks/cecil.webp" class="card-img-top" alt="Cecil Bar & Restaurant">
            <div class="card-body">
              <h5 class="card-title">Cecil Bar & Restaurant</h5>
              <p class="card-text">Classic north/central joint with steady footfall for North Indian and Chinese food. Alcoholic beverages are also served.</p>
              <a class="btn btn-primary" onclick="showToast()">Save For an Evening</a>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div id="saveToast" class="toast-message">
      Place is Saved For You
    </div>

    <%- include('partials/route-map') %>

    <footer>
      <div class="container">
        <div class="row align-items-center">
          <div class="col-md-6">
            <h5 class="fw-bold mb-1">🌆 শহরের সন্ধ্যা'zzz v0.4</h5>
            <small class="text-muted">Its All about spreading positivity</small>
          </div>
          <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a href="#" class="text-decoration-none text-muted me-3">About</a>
            <a href="#" class="text-decoration-none text-muted me-3">Businesses</a>
            <a href="#" class="text-decoration-none text-muted">Contact</a>
          </div>
        </div>
        <hr />
        <div class="text-center text-muted small">
          © <%= new Date().getFullYear() %> শহরের সন্ধ্যা'zzz - Designed, Developed and Managed By - Arindam Samadder
        </div>
      </div>
    </footer>

    <%- include("./partials/chatbot") %>
    <%- include('./partials/scripts') %>

    <script>
      function showToast() {
        const toast = document.getElementById("saveToast");
        toast.style.display = "block";
        setTimeout(() => {
          toast.style.display = "none";
        }, 2500);
      }
    </script>
  </body>
</html>