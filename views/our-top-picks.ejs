    <div class="position-fixed bottom-0 end-0 p-4" style="z-index: 1001;">
      <button
        class="btn btn-success rounded-pill shadow"
        data-bs-toggle="collapse"
        data-bs-target="#mapPanel"
        id="mapButton"
      >
        📍 EXPLORE LOCATIONS & ROUTES
      </button>

      <div class="collapse mt-3" id="mapPanel">
        <div class="card shadow" style="width: 550px; max-width: 90vw;">
          <div class="card-header d-flex justify-content-between">
            <span id="mapTitle">Map Routes</span>
            <button class="btn-close" data-bs-toggle="collapse" data-bs-target="#mapPanel"></button>
          </div>

          <div class="container-fluid mt-4">
            <div id="dbMapContainer" style="display: block;">
              <div class="map-box"><div id="map"></div></div>
              <div id="route-list" class="mt-3 p-3" style="max-height: 150px; overflow-y: auto;"></div>
            </div>

            <div id="aiMapContainer" style="display: none;">
              <div class="map-box"><div id="aiMap"></div></div>
              <div id="aiMapTitle"></div>
            </div>
          </div>
        </div>
      </div>
