<style>
    body { padding-top: 90px; }
    .saturn-navbar { background: linear-gradient(135deg, rgba(18, 47, 133, 0.75), rgba(18, 19, 24, 0.95), rgba(150, 14, 14, 0.75)); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.12); border-radius: 22px; margin: 10px 14px; min-height: 72px; box-shadow: 0 10px 35px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.08); position: fixed; top: 10px; left: 14px; right: 14px; z-index: 2000; }
    .saturn-brand { color: white !important; margin-right: 35px; text-decoration: none; gap: 10px; }
    .brand-logo { width: 60px; height: 42px; border-radius: 13px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(255,255,255,0.16), rgba(255,255,255,0.04)); box-shadow: inset 0 1px 0 rgba(255,255,255,0.15), 0 5px 15px rgba(0,0,0,0.3); }
    .brand-logo img { width: 60px; height: 30px; object-fit: contain; }
    .brand-text { display: flex; flex-direction: column; line-height: 1; }
    .brand-name { font-size: 0.95rem; font-weight: 800; letter-spacing: 1.5px; }
    .brand-text small { margin-top: 5px; font-size: 0.63rem; color: rgba(255,255,255,0.48); letter-spacing: 0.5px; }
    .saturn-nav { gap: 5px; }
    .saturn-link { color: #f5f5f5 !important; font-weight: 600; border-radius: 13px; padding: 11px 15px !important; font-size: 0.9rem; transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease; }
    .saturn-link span { margin-right: 5px; filter: brightness(1.25); }
    .saturn-link:hover { color: white !important; background: rgba(255,255,255,0.08); transform: translateY(-1px); }
    .saturn-link:focus { color: white !important; background: rgba(255,255,255,0.08); }
    .account-button { display: flex; align-items: center; gap: 9px; padding: 6px 12px 6px 7px; border-radius: 15px; border: 1px solid rgba(255,255,255,0.10); background: rgba(255,255,255,0.06); color: white; transition: 0.2s; }
    .account-button:hover { background: rgba(255,255,255,0.11); border-color: rgba(255,255,255,0.18); }
    .account-avatar { width: 37px; height: 37px; border-radius: 11px; display: flex; align-items: center; justify-content: center; font-weight: 700; color: white; background: linear-gradient(135deg, #343a40, #111318); border: 1px solid rgba(255,255,255,0.12); box-shadow: inset 0 1px 0 rgba(255,255,255,0.12); }
    .account-avatar.large { width: 42px; height: 42px; border-radius: 13px; }
    .account-info { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.1; }
    .account-info span { font-size: 0.82rem; font-weight: 600; }
    .account-info small { margin-top: 4px; font-size: 0.65rem; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 0.5px; }
    .account-header { display: flex; align-items: center; gap: 11px; padding: 8px 10px; }
    .account-header strong { display: block; color: white; font-size: 0.9rem; }
    .account-header small { display: block; margin-top: 4px; color: rgba(255,255,255,0.45); font-size: 0.7rem; }
    .account-role { font-size: 0.75rem !important; text-transform: uppercase; letter-spacing: 1px; }
    .logout-item { color: #ff8585 !important; }
    .logout-item:hover { color: #ffaaaa !important; background: rgba(255,70,70,0.08) !important; }
    .saturn-toggler { border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; padding: 7px 9px; }
    .saturn-toggler:focus { box-shadow: 0 0 0 3px rgba(255,255,255,0.08); }
    .glass-error { border-radius: 16px; background: rgba(220,53,69,0.12); backdrop-filter: blur(12px); border: 1px solid rgba(220,53,69,0.2); }
</style>

<nav class="navbar navbar-expand-lg saturn-navbar">
  <div class="container-fluid px-4">
    
    <a class="navbar-brand saturn-brand d-flex align-items-center" href="/">
      <div class="brand-logo"><img src="/images/logo.png" alt="Logo" /></div>
      <div class="brand-text">
        <span class="brand-name">শহরের সন্ধ্যা'zzz</span>
        <small>Discover your city</small>
      </div>
    </a>

    <button class="navbar-toggler saturn-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll" aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarScroll">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 saturn-nav">
        <li class="nav-item">
          <a class="nav-link saturn-link" href="/"><span>🏠</span> Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link saturn-link" href="/our-top-picks"><span>✨</span> Our Top Picks</a>
        </li>
        <li class="nav-item">
          <a class="nav-link saturn-link" href="/user-posts/happening-now"><span>👀</span> What's-Up in শহর Rn_</a>
        </li>
        <li class="nav-item">
          <a class="nav-link saturn-link" href="/businesses/this-week"><span>🧭</span> শহরে'র-Business Schedule..</a>
        </li>
        <li class="nav-item">
          <a class="nav-link saturn-link" href="/city-tours"><span>🏇🏻</span> শহরে'র-Tours</a>
        </li>
      </ul>

      <% if (locals.user) { %>
        <div class="dropdown">
          <button class="account-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="account-avatar"><%= user.fullName.charAt(0).toUpperCase() %></div>
            <div class="account-info">
              <span><%= user.fullName %></span>
              <small><%= user.role %></small>
            </div>
          </button>
          <ul class="dropdown-menu dropdown-menu-end saturn-dropdown account-dropdown">
            <li>
              <div class="account-header">
                <div class="account-avatar large"><%= user.fullName.charAt(0).toUpperCase() %></div>
                <div>
                  <strong><%= user.fullName %></strong>
                  <small><%= user.email %></small>
                </div>
              </div>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li><span class="dropdown-item-text account-role">◉ <%= user.role %></span></li>
            <li><a class="dropdown-item logout-item" href="/user/logout">↪ Logout</a></li>
          </ul>
        </div>
      <% } else { %>
        <div class="dropdown">
          <button class="account-button" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="account-avatar">👤</div>
            <div class="account-info">
              <span>Account</span>
              <small>Login / Sign Up</small>
            </div>
            <span class="ms-2">⌄</span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end saturn-dropdown">
            <li><a class="dropdown-item" href="/user/signin">🔑 Login</a></li>
            <li><a class="dropdown-item" href="/user/signup">✨ Create Account</a></li>
          </ul>
        </div>
      <% } %>
    </div>
  </div>
</nav>

<% if (locals.error) { %>
  <div class="container mt-3">
    <div class="alert alert-danger glass-error" role="alert">
      ⚠️ <strong>Error:</strong> <%= locals.error %>
    </div>
  </div>
<% } %>